# Copy to .env at the repo root for Docker (cp .env.example .env), or to backend/.env for
# running without Docker. Never commit real values.

# Comma-separated Gemini API keys, at least 2, no spaces. Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your_key_1,your_key_2

# SQLite file. docker-compose.yml forces sqlite:////data/app.db (the named volume).
# For local runs without Docker, use sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to call the API (add the deployed frontend URL).
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure test header (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true

# LiteLLM model name (verified with real calls on both keys).
# gemini-2.5-flash works but its free tier allows only 20 requests/day; 2.0-flash and 2.5-flash-lite return 404.
LLM_MODEL=gemini/gemini-3.5-flash-lite

# System prompt used when a session does not set its own.
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Seconds to wait for one provider call before failing over to the next key.
LLM_TIMEOUT=30

# Frontend (build-time, read by Vite): where the browser finds the backend API.
# Set it to the deployed backend URL when building the deployed frontend.
VITE_API_URL=http://localhost:8000

# Port the backend listens on (used by the Dockerfile and docker-compose.yml, not by the Python code).
PORT=8000
